# ============================================================
# BRAINSTORM INFOTECH PORTAL - ENVIRONMENT TEMPLATE
# Instructions: Copy this file to '.env' and fill out the values.
# Then run `docker-compose up -d`
# ============================================================

# --- Core Settings ---
NODE_ENV=production
PORT=5050

# --- Authentication ---
# Note: Google Login requires you to add your domain to the Authorized JavaScript Origins in the Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- Master Admin Fallback ---
# (You can also sign in via Google with the email below, or use the username/password directly)
ADMIN_USERNAME=arjun
ADMIN_PASSWORD=secret_password_here
ADMIN_EMAIL=arjuns@brainstorminfotech.co.in

# --- Cloud Storage (Cloudflare R2 / AWS S3) ---
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=your_bucket_name

# --- Database ---
# (Leave as-is if using the included Postgres container in docker-compose)
DB_CLIENT=pg
DATABASE_URL=postgres://postgres:brainstorm_db_pass@db:5432/brainstorm
